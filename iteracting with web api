import requests
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. API DETAILS
API_KEY = "YOUR_API_KEY"
CITY = "Pune"

url = f"https://api.openweathermap.org/data/2.5/forecast?q={CITY}&appid={API_KEY}&units=metric"

# 2. FETCH DATA FROM API
response = requests.get(url)
data = response.json()

if response.status_code == 200:

    records = []

    # 3. EXTRACT WEATHER DATA
    for item in data["list"]:
        records.append({
            "Date": item["dt_txt"],
            "Temperature": item["main"]["temp"],
            "Humidity": item["main"]["humidity"],
            "Pressure": item["main"]["pressure"],
            "Wind Speed": item["wind"]["speed"],
            "Rain": item.get("rain", {}).get("3h", 0)
        })

    # 4. CREATE DATAFRAME
    weather_df = pd.DataFrame(records)

    weather_df["Date"] = pd.to_datetime(weather_df["Date"])

    print("Weather Data")
    print(weather_df.head())

    # 5. DATA INFORMATION
    print("\nData Information")
    weather_df.info()

    print("\nMissing Values")
    print(weather_df.isnull().sum())

    # 6. DATA CLEANING
    weather_df.fillna(0, inplace=True)
    weather_df.drop_duplicates(inplace=True)

    print("\nCleaned Data")
    print(weather_df.head())

    # 7. STATISTICS
    print("\nStatistics")

    print("Average Temperature:",
          weather_df["Temperature"].mean())

    print("Maximum Temperature:",
          weather_df["Temperature"].max())

    print("Minimum Temperature:",
          weather_df["Temperature"].min())

    print("Average Humidity:",
          weather_df["Humidity"].mean())

    print("Average Wind Speed:",
          weather_df["Wind Speed"].mean())

    # 8. DAILY WEATHER SUMMARY
    daily_data = weather_df.set_index("Date").resample("D").agg({
        "Temperature": "mean",
        "Humidity": "mean",
        "Wind Speed": "mean",
        "Rain": "sum"
    })

    print("\nDaily Weather Summary")
    print(daily_data)

    # 9. TEMPERATURE LINE GRAPH
    plt.figure(figsize=(10, 5))
    plt.plot(weather_df["Date"],
             weather_df["Temperature"],
             marker="o")

    plt.title("Temperature Variation")
    plt.xlabel("Date")
    plt.ylabel("Temperature (°C)")
    plt.xticks(rotation=45)
    plt.grid(True)
    plt.tight_layout()
    plt.show()

    # 10. DAILY RAINFALL BAR GRAPH
    plt.figure(figsize=(8, 5))
    plt.bar(daily_data.index, daily_data["Rain"])

    plt.title("Daily Rainfall")
    plt.xlabel("Date")
    plt.ylabel("Rainfall (mm)")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.show()

    # 11. TEMPERATURE VS HUMIDITY
    plt.figure(figsize=(8, 5))
    plt.scatter(weather_df["Temperature"],
                weather_df["Humidity"])

    plt.title("Temperature vs Humidity")
    plt.xlabel("Temperature (°C)")
    plt.ylabel("Humidity (%)")
    plt.show()

    # 12. CORRELATION HEATMAP
    plt.figure(figsize=(7, 5))

    sns.heatmap(
        weather_df[[
            "Temperature", "Humidity", "Pressure",
            "Wind Speed", "Rain"
        ]].corr(),
        annot=True
    )

    plt.title("Weather Correlation Heatmap")
    plt.show()

    # 13. GEOGRAPHICAL INFORMATION
    latitude = data["city"]["coord"]["lat"]
    longitude = data["city"]["coord"]["lon"]

    print("\nGeographical Information")
    print("City:", CITY)
    print("Latitude:", latitude)
    print("Longitude:", longitude)

else:
    print("Error:", data)




import requests – Imports the Requests library to connect with web APIs and fetch data.
import pandas as pd – Imports Pandas for data handling and analysis.
import matplotlib.pyplot as plt – Imports Matplotlib to create graphs.
import seaborn as sns – Imports Seaborn to create statistical visualizations like heatmaps.

API_KEY – Stores the API key required to access OpenWeatherMap.
CITY = "Pune" – Specifies the city for which we want weather information.
url – Stores the API request URL.
f – Creates an f-string to insert variables into the URL.
q={CITY} – Specifies the city name.
appid={API_KEY} – Sends the API key for authentication.
units=metric – Gets temperature in Celsius and wind speed in metres per second.

requests.get(url) – Sends a GET request to the API.
response – Stores the response received from the API.
response.json() – Converts the API response into Python dictionary format.
status_code – Checks the HTTP response status.
200 – Means the request was successful.
if – Executes the code only when the API request is successful.

records = [] – Creates an empty list to store weather records.
for item in data["list"] – Iterates through each weather forecast record received from the API.
records.append() – Adds each weather record to the list.
"Date" – Stores the date and time of the forecast.
"Temperature" – Stores temperature in Celsius.
"Humidity" – Stores humidity percentage.
"Pressure" – Stores atmospheric pressure in hPa.
"Wind Speed" – Stores wind speed in metres per second.
"Rain" – Stores rainfall in the last 3 hours.
.get("rain", {}) – Gets rainfall information if available; otherwise returns an empty dictionary.
get("3h", 0) – Gets the 3-hour rainfall value; if unavailable, returns 0.

pd.DataFrame(records) – Converts the list of weather records into a Pandas DataFrame.
weather_df – Stores the weather dataset.
pd.to_datetime() – Converts the Date column into datetime format.
print() – Displays the output.
.head() – Displays the first five records.

- weather_df.info() – Displays rows, columns, data types and non-null values.
- .isnull() – Checks missing values.
- .sum() – Counts the missing values in each column.
- \n – Moves the output to a new line.
7. Data Cleaning
weather_df.fillna(0, inplace=True)weather_df.drop_duplicates(inplace=True)print("\nCleaned Data")print(weather_df.head())



- .fillna(0) – Replaces missing values with zero.
- inplace=True – Modifies the original DataFrame.
- .drop_duplicates() – Removes duplicate records.
- .head() – Displays the cleaned dataset.
8. Statistical Analysis
print("\nStatistics")print("Average Temperature:",      weather_df["Temperature"].mean())print("Maximum Temperature:",      weather_df["Temperature"].max())print("Minimum Temperature:",      weather_df["Temperature"].min())print("Average Humidity:",      weather_df["Humidity"].mean())print("Average Wind Speed:",      weather_df["Wind Speed"].mean())



- .mean() – Calculates the average value.
- .max() – Finds the maximum value.
- .min() – Finds the minimum value.
- ["Temperature"] – Selects the Temperature column.
- ["Humidity"] – Selects the Humidity column.
- ["Wind Speed"] – Selects the Wind Speed column.
This step calculates the average, maximum and minimum temperature, average humidity and average wind speed.
9. Daily Weather Summary
daily_data = weather_df.set_index("Date").resample("D").agg({    "Temperature": "mean",    "Humidity": "mean",    "Wind Speed": "mean",    "Rain": "sum"})print("\nDaily Weather Summary")print(daily_data)



- .set_index("Date") – Sets the Date column as the index.
- .resample("D") – Groups the data by day.
- .agg() – Performs different calculations on different columns.
- "Temperature": "mean" – Calculates daily average temperature.
- "Humidity": "mean" – Calculates daily average humidity.
- "Wind Speed": "mean" – Calculates daily average wind speed.
- "Rain": "sum" – Calculates total recorded rainfall per day.
- daily_data – Stores the daily weather summary.
