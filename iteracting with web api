# THEORY:
# Web API (Application Programming Interface) allows applications
# to communicate and exchange data over the internet.
# OpenWeatherMap API provides weather information in JSON format.
# Python libraries are used to retrieve, process, analyze and visualize
# weather data such as temperature, humidity, pressure and rainfall.


# 1. IMPORT NECESSARY LIBRARIES

import requests
# Requests is used to send HTTP requests and retrieve weather data from the API.

import pandas as pd
# Pandas is used to store, organize, clean and analyze weather data.

import matplotlib.pyplot as plt
# Matplotlib is used to create graphs and visualize weather information.

import seaborn as sns
# Seaborn is used to create statistical visualizations such as heatmaps.


# 2. API DETAILS

API_KEY = "YOUR_API_KEY"
# Stores the OpenWeatherMap API key required to access weather information.

CITY = "Pune"
# Specifies the city for which weather data is required.

url = f"https://api.openweathermap.org/data/2.5/forecast?q={CITY}&appid={API_KEY}&units=metric"
# Creates the API URL using the city name and API key.
# The metric parameter retrieves temperature in Celsius.


# 3. FETCH DATA FROM API

response = requests.get(url)
# Sends a GET request to the OpenWeatherMap API.

data = response.json()
# Converts the API response into JSON format for accessing weather information.


# Checks whether the API request was successful.
if response.status_code == 200:

    records = []
    # Creates an empty list to store extracted weather records.


    # 4. EXTRACT WEATHER DATA

    for item in data["list"]:
        # Iterates through each weather forecast record.

        records.append({
            "Date": item["dt_txt"],
            # Extracts the date and time of the forecast.

            "Temperature": item["main"]["temp"],
            # Extracts the temperature in Celsius.

            "Humidity": item["main"]["humidity"],
            # Extracts the humidity percentage.

            "Pressure": item["main"]["pressure"],
            # Extracts atmospheric pressure in hPa.

            "Wind Speed": item["wind"]["speed"],
            # Extracts wind speed in metres per second.

            "Rain": item.get("rain", {}).get("3h", 0)
            # Extracts rainfall for 3 hours.
            # Returns 0 if rainfall information is unavailable.
        })


    # 5. CREATE DATAFRAME

    weather_df = pd.DataFrame(records)
    # Converts the extracted weather records into a Pandas DataFrame.

    weather_df["Date"] = pd.to_datetime(weather_df["Date"])
    # Converts the Date column into datetime format for time-based analysis.

    print("Weather Data")
    # Displays the heading for weather data.

    print(weather_df.head())
    # Displays the first five records of the weather dataset.


    # 6. DISPLAY DATA INFORMATION

    print("\nData Information")
    # Displays the heading for dataset information.

    print(weather_df.info())
    # Displays column names, data types and non-null values.
    # Note: info() itself prints the information and returns None.

    print("\nMissing Values")
    # Displays the heading for missing values.

    print(weather_df.isnull().sum())
    # Counts the missing values in each column.


    # 7. DATA CLEANING

    weather_df.fillna(0, inplace=True)
    # Replaces missing values with zero.

    weather_df.drop_duplicates(inplace=True)
    # Removes duplicate records from the dataset.

    print("\nCleaned Data")
    # Displays the heading for cleaned data.

    print(weather_df.head())
    # Displays the first five records after data cleaning.


    # 8. STATISTICAL ANALYSIS

    print("\nStatistics")
    # Displays the heading for statistical analysis.

    print("Average Temperature:",
          weather_df["Temperature"].mean())
    # Calculates and displays the average temperature.

    print("Maximum Temperature:",
          weather_df["Temperature"].max())
    # Calculates and displays the maximum temperature.

    print("Minimum Temperature:",
          weather_df["Temperature"].min())
    # Calculates and displays the minimum temperature.

    print("Average Humidity:",
          weather_df["Humidity"].mean())
    # Calculates and displays the average humidity.

    print("Average Wind Speed:",
          weather_df["Wind Speed"].mean())
    # Calculates and displays the average wind speed.


    # 9. DAILY WEATHER SUMMARY

    daily_data = weather_df.set_index("Date").resample("D").agg({
        # Sets Date as the index and groups weather records by day.

        "Temperature": "mean",
        # Calculates the average daily temperature.

        "Humidity": "mean",
        # Calculates the average daily humidity.

        "Wind Speed": "mean",
        # Calculates the average daily wind speed.

        "Rain": "sum"
        # Calculates the total daily rainfall.
    })

    print("\nDaily Weather Summary")
    # Displays the heading for the daily weather summary.

    print(daily_data)
    # Displays the aggregated daily weather information.


    # 10. TEMPERATURE LINE GRAPH

    plt.figure(figsize=(10, 5))
    # Creates a figure with width 10 inches and height 5 inches.

    plt.plot(
        weather_df["Date"],
        weather_df["Temperature"],
        marker="o"
    )
    # Plots date against temperature using a line graph.
    # The marker represents individual temperature readings.

    plt.title("Temperature Variation")
    # Sets the title of the graph.

    plt.xlabel("Date")
    # Labels the X-axis as Date.

    plt.ylabel("Temperature (°C)")
    # Labels the Y-axis as Temperature in Celsius.

    plt.xticks(rotation=45)
    # Rotates date labels by 45 degrees for better readability.

    plt.grid(True)
    # Displays grid lines on the graph.

    plt.tight_layout()
    # Adjusts the graph layout to prevent overlapping labels.

    plt.show()
    # Displays the temperature line graph.


    # 11. DAILY RAINFALL BAR GRAPH

    plt.figure(figsize=(8, 5))
    # Creates a figure with width 8 inches and height 5 inches.

    plt.bar(
        daily_data.index,
        daily_data["Rain"]
    )
    # Creates a bar graph showing daily rainfall.

    plt.title("Daily Rainfall")
    # Sets the title of the graph.

    plt.xlabel("Date")
    # Labels the X-axis as Date.

    plt.ylabel("Rainfall (mm)")
    # Labels the Y-axis as Rainfall in millimetres.

    plt.xticks(rotation=45)
    # Rotates date labels by 45 degrees.

    plt.tight_layout()
    # Adjusts the graph layout.

    plt.show()
    # Displays the daily rainfall bar graph.


    # 12. TEMPERATURE VS HUMIDITY SCATTER PLOT

    plt.figure(figsize=(8, 5))
    # Creates a figure with width 8 inches and height 5 inches.

    plt.scatter(
        weather_df["Temperature"],
        weather_df["Humidity"]
    )
    # Creates a scatter plot to show the relationship
    # between temperature and humidity.

    plt.title("Temperature vs Humidity")
    # Sets the title of the graph.

    plt.xlabel("Temperature (°C)")
    # Labels the X-axis as Temperature.

    plt.ylabel("Humidity (%)")
    # Labels the Y-axis as Humidity.

    plt.show()
    # Displays the scatter plot.


    # 13. CORRELATION HEATMAP

    plt.figure(figsize=(7, 5))
    # Creates a figure with width 7 inches and height 5 inches.

    sns.heatmap(
        weather_df[
            ["Temperature", "Humidity", "Pressure",
             "Wind Speed", "Rain"]
        ].corr(),
        annot=True
    )
    # Calculates correlations between weather attributes.
    # Displays the correlation values in a heatmap.

    plt.title("Weather Correlation Heatmap")
    # Sets the title of the heatmap.

    plt.show()
    # Displays the correlation heatmap.


    # 14. GEOGRAPHICAL INFORMATION

    latitude = data["city"]["coord"]["lat"]
    # Extracts the latitude of the selected city from the API response.

    longitude = data["city"]["coord"]["lon"]
    # Extracts the longitude of the selected city from the API response.

    print("\nGeographical Information")
    # Displays the heading for geographical information.

    print("City:", CITY)
    # Displays the selected city name.

    print("Latitude:", latitude)
    # Displays the latitude of the city.

    print("Longitude:", longitude)
    # Displays the longitude of the city.


else:
    # Executes when the API request is unsuccessful.

    print("Error:", data)
    # Displays the error information returned by the API.
